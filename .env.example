# Nasscord app (Next.js). Copy to .env.local for development; set the same names in Vercel.
# docs/SETUP.md walks through every value. docs/real-backend.md section 2 is the contract.
# Never commit real values. Only the NEXT_PUBLIC_* names reach the browser.

# Supabase project (Project Settings -> API). Without these the public site still works and
# the sign-in pages say that Supabase is not configured.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row level security: never expose it, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used in email links (confirm signup, reset password). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Apex domain of the platform. Workspaces live on <slug>.<domain>; white-label tenants on their own domain.
NEXT_PUBLIC_APP_DOMAIN=nasscord.com

# Broker service (services/broker). The app signs a 60-second HS256 JWT with the shared secret.
BROKER_SERVICE_URL=http://localhost:8710
# At least 32 random bytes, the same value as in services/broker/.env. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
BROKER_SERVICE_SECRET=

# Comma-separated. A confirmed signup with one of these emails becomes the super admin.
NASSCORD_SUPERADMIN_EMAILS=
