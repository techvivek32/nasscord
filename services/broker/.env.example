# Copy to .env for local development (npm start loads it), or to /etc/nasscord-broker.env on the
# VPS (systemd EnvironmentFile: KEY=value, no quotes). Never commit the real file.
#
# Generate the two secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

API_PORT=8710
LOGIN_PORT=8711
# Public origin of the IBKR login host. Local: http://localhost:8711. VPS: https://ibkr-login.<domain>
PUBLIC_LOGIN_URL=http://localhost:8711
# Where the "Back to Nasscord" link on the login host points. Local: the Next app on 3000.
# VPS: the app's public URL, e.g. https://nasscord-phi.vercel.app
NASSCORD_APP_URL=http://localhost:3000

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Same value as BROKER_SERVICE_SECRET in the Next app (at least 32 bytes).
BROKER_SERVICE_SECRET=<random, 32+ bytes>
# base64 of exactly 32 random bytes. Losing it makes every stored E*TRADE token unreadable.
BROKER_TOKEN_KEY=<base64 of 32 random bytes>
BROKER_TOKEN_KEY_VERSION=1
# During a key rotation: the old keys, "version:base64" comma-separated.
# BROKER_TOKEN_KEYS_PREVIOUS=1:<old base64 key>

# Folder with dist/, build/lib/runtime/ and root/ of the IBKR Client Portal Gateway.
IBKR_GATEWAY_BUNDLE=vendor/clientportal.gw
IBKR_GATEWAY_RUNTIME=runtime
IBKR_GATEWAY_PORTS=7200-7249
JAVA_BIN=java
IBKR_GATEWAY_XMX=256m

# E*TRADE sandbox keys serve E*TRADE's sample accounts. Accepted by default outside production for
# developers; always refused when NODE_ENV=production (the systemd unit sets it), whatever this says.
ETRADE_ALLOW_SANDBOX=false

# Optional limits (defaults shown): connect steps per user in 10 minutes, new connections per
# minute for the whole process, and IBKR gateways waiting for a login (default: half the slots).
# BROKER_CONNECT_PER_USER=20
# BROKER_CONNECT_GLOBAL_PER_MIN=60
# IBKR_MAX_PENDING_LOGINS=25

LOG_LEVEL=info

# ── More brokers (docs/real-backend.md sections 2, 8 and 9). All optional: a method without its
# credentials answers "not configured" in GET /v1/options.

# The canonical origin every broker returns to: <base>/api/broker/callback/<broker>. Frozen once
# registered with Schwab and TradeStation. Https in production; defaults to NASSCORD_APP_URL locally.
# OAUTH_CALLBACK_BASE=https://nasscord.com

# Who may use each connect method: all, superadmin or off. Defaults: ibkr_gateway, etrade_oauth1,
# alpaca_key and snaptrade = all; everything else = superadmin. "all=all" opens everything (local
# testing only).
# BROKER_AUDIENCE=schwab_oauth.user=superadmin,tradier_token=superadmin

# Local fake brokers, per broker package. Refused in production.
# BROKER_URL_OVERRIDES={"alpaca":{"live":"http://127.0.0.1:9001","paper":"http://127.0.0.1:9001"}}

# ALPACA_CLIENT_ID=
# ALPACA_CLIENT_SECRET=
# TRADIER_CLIENT_ID=
# TRADIER_CLIENT_SECRET=
# TRADIER_REFRESH_TOKENS=false
# TRADIER_SANDBOX_TOKENS=false
# SCHWAB_CLIENT_ID=
# SCHWAB_CLIENT_SECRET=
# TASTYTRADE_CLIENT_ID=
# TASTYTRADE_CLIENT_SECRET=
# TASTYTRADE_ENV=production
# TASTYTRADE_API_VERSION=20261012
# TRADESTATION_CLIENT_ID=
# TRADESTATION_CLIENT_SECRET=
# TRADESTATION_ALLOW_SIM=false
# WEBULL_CLIENT_ID=
# WEBULL_CLIENT_SECRET=
# WEBULL_APP_KEY=
# WEBULL_APP_SECRET=
# WEBULL_ENV=production
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=
# SNAPTRADE_BROKERS=fidelity,robinhood,public,moomoo,webull
# SNAPTRADE_PLAN=daily
