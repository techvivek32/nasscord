# Copy to .env for local development (npm start loads it), or to /etc/nasscord-broker.env on the
# VPS (systemd EnvironmentFile: KEY=value, no quotes). Never commit the real file.
#
# Generate the two secrets with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"

API_PORT=8710
LOGIN_PORT=8711
# Public origin of the IBKR login host. Local: http://localhost:8711. VPS: https://ibkr-login.<domain>
PUBLIC_LOGIN_URL=http://localhost:8711
# Where the "Back to Nasscord" link on the login host points. Local: the Next app on 3000.
# VPS: the app's public URL, e.g. https://nasscord-phi.vercel.app
NASSCORD_APP_URL=http://localhost:3000

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Same value as BROKER_SERVICE_SECRET in the Next app (at least 32 bytes).
BROKER_SERVICE_SECRET=<random, 32+ bytes>
# base64 of exactly 32 random bytes. Losing it makes every stored E*TRADE token unreadable.
BROKER_TOKEN_KEY=<base64 of 32 random bytes>
BROKER_TOKEN_KEY_VERSION=1
# During a key rotation: the old keys, "version:base64" comma-separated.
# BROKER_TOKEN_KEYS_PREVIOUS=1:<old base64 key>

# Folder with dist/, build/lib/runtime/ and root/ of the IBKR Client Portal Gateway.
IBKR_GATEWAY_BUNDLE=vendor/clientportal.gw
IBKR_GATEWAY_RUNTIME=runtime
IBKR_GATEWAY_PORTS=7200-7249
JAVA_BIN=java
IBKR_GATEWAY_XMX=256m

# Sandbox keys are accepted by default outside production and refused by default in production
# (the systemd unit sets NODE_ENV=production). Set it on purpose: true while testing with a
# sandbox key, false for real users.
ETRADE_ALLOW_SANDBOX=false

# Optional limits (defaults shown): connect steps per user in 10 minutes, new connections per
# minute for the whole process, and IBKR gateways waiting for a login (default: half the slots).
# BROKER_CONNECT_PER_USER=20
# BROKER_CONNECT_GLOBAL_PER_MIN=60
# IBKR_MAX_PENDING_LOGINS=25

LOG_LEVEL=info
