# /etc/systemd/system/nasscord-broker.service
# Nasscord broker service: one Node 24 process, IBKR gateway JVMs as its children.
#
#   sudo cp deploy/nasscord-broker.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now nasscord-broker
#   journalctl -u nasscord-broker -f
#
# It runs as its own system user, nasscord-broker (docs/SETUP.md step 11). With order entry, a
# logged-in IBKR gateway takes orders from any local process that reaches its slot port, so only
# this user may reach the slot ports (an iptables owner rule), and the app must not run as it.
#   sudo useradd --system --home-dir /var/lib/nasscord-broker --shell /usr/sbin/nologin nasscord-broker
# The code and the gateway bundle must be readable by its group. No workspace gets order entry
# before the user, this unit and the port rule are in place and checked (release gate, D22).

[Unit]
Description=Nasscord broker service (IBKR gateways, E*TRADE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nasscord-broker
Group=nasscord-broker
WorkingDirectory=/opt/nasscord-broker
# KEY=value lines, no quotes, no "export". Readable by root only (chmod 600).
EnvironmentFile=/etc/nasscord-broker.env
Environment=NODE_ENV=production
Environment=IBKR_GATEWAY_RUNTIME=/var/lib/nasscord-broker/runtime
ExecStart=/usr/bin/node src/server.mjs
# A crash (uncaught exception) shuts the gateways down and exits 1, so it is restarted.
# A stop (SIGTERM from systemctl, SIGINT) exits 0 and stays stopped.
Restart=on-failure
RestartSec=5
# 78 = bad configuration: do not restart in a loop, fix /etc/nasscord-broker.env first.
RestartPreventExitStatus=78

# The gateway JVMs are children of this process. KillMode=mixed sends SIGTERM to the Node process
# only: it refuses new orders, waits up to 45 s for the orders in flight (the IBKR gateways stay up
# meanwhile, so no order is cut off from its gateway), then stops every gateway itself and exits
# (hard exit after 55 s). Whatever is still left in the group is killed after the main process
# exits, so no orphaned Java keeps a slot port. TimeoutStopSec leaves room for all of that.
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=60

# /var/lib/nasscord-broker, owned by the service user, for the per-slot gateway config and logs.
StateDirectory=nasscord-broker
StateDirectoryMode=0700
UMask=0077

# Hardening. Java needs writable+executable memory for its JIT, so MemoryDenyWriteExecute stays off.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
